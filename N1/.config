# ==================================================================================
# ImmortalWrt 斐讯N1固件编译配置文件
# 目标平台：armsr (ARM64 Virtualization/Server) - 适用于虚拟化和ARM开发板
# 芯片型号：Amlogic S905D (ARM Cortex-A53, 64-bit)
# 固件类型：btrfs文件系统 + ARM64架构
# ==================================================================================

# ==================================================================================
# 【第一部分】目标平台配置 - 定义编译目标为ARM64 virtualization
# 【架构说明】
# armsr是OpenWrt为ARM64服务器/虚拟化场景设计的目标
# 相比传统的armvirt，armsr更适合需要持久化存储的场景
# 设备选择：generic - 通用的ARM64设备配置，兼容性最好
# ==================================================================================

# 【armsr平台主开关】启用ARM64服务器目标平台
# 业务逻辑：告诉OpenWrt构建系统生成ARM64架构的固件
# 技术背景：S905D是4核Cortex-A53 ARMv8架构，支持64位指令集
CONFIG_TARGET_armsr=y

# 【ARMv8指令集】启用ARMv8-A架构支持（Cortex-A53/A72/A76等）
# 业务逻辑：S905D基于ARMv8-A架构，启用该选项支持64位运算
# 性能影响：相比32位ARMv7，内存寻址能力和计算性能显著提升
CONFIG_TARGET_armsr_armv8=y

# 【通用设备配置】使用通用的ARM64设备配置模板
# 业务逻辑：避免使用特殊化的设备配置，提高兼容性
# 备选：可选择DEVICE_amlogic_s905d_n1针对N1特殊优化
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y

# ==================================================================================
# 【第二部分】根文件系统格式配置 - 定义输出镜像的文件系统类型
# 【文件系统说明】N1固件采用btrfs作为根文件系统
# 选择原因：btrfs支持COW快照、压缩、透明加密等企业级特性
# ==================================================================================

# 【INITRAMFS】不生成独立的Initramfs镜像
# 业务逻辑：Initramfs主要用于内存文件系统启动，N1从emmc启动不需要
# 关闭后可减少固件体积约50-100MB
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# 【CPIOGZ】不生成cpiogz格式的压缩根文件系统
# 业务逻辑：cpiogz是早期OpenWrt使用的压缩格式，已被btrfs取代
# 关闭可减少构建时间和输出格式种类
CONFIG_TARGET_ROOTFS_CPIOGZ=n

# 【EXT4】不生成EXT4格式的根文件系统镜像
# 业务逻辑：N1使用btrfs，EXT4主要用于x86虚拟机场景
# 关闭后可减少构建产物种类
CONFIG_TARGET_ROOTFS_EXT4FS=n

# 【SQUASHFS】不生成SquashFS格式的只读文件系统
# 业务逻辑：SquashFS适合嵌入式设备的Overlay文件系统
# 但btrfs更灵活，支持读写和快照，N1场景下更合适
CONFIG_TARGET_ROOTFS_SQUASHFS=n

# ==================================================================================
# 【第三部分】IPv6支持配置 - 网络协议栈扩展
# ==================================================================================

# 【IPv6完整支持包】启用完整的IPv6功能支持
# 业务逻辑：支持IPv6协议栈、IPv6隧道、IPv6防火墙规则等
# 适用场景：当前大多数家庭宽带已支持IPv6，启用后可实现双栈访问
# 依赖包：ip6tables, kmod-ip6tables, odhcp6c等
CONFIG_PACKAGE_ipv6helper=y

# ==================================================================================
# 【第四部分】内核模块配置 - 硬件驱动和功能支持
# 【驱动选择策略】只启用N1需要的驱动，禁用其他平台驱动以减少体积
# 优化原则：启用必要的，禁用无关的，实现固件体积最小化
# ==================================================================================

# 【Amazon ENA网卡驱动】禁用 - N1不使用亚马逊弹性网络适配器
CONFIG_PACKAGE_kmod-amazon-ena=n

# 【AHCI SATA驱动】启用 - 支持N1的SATA接口（如果接驳SATA设备）
# 业务逻辑：S905D芯片支持SATA接口，启用后可识别SATA硬盘
# 使用场景：外接SATA硬盘盒作为家庭存储
CONFIG_PACKAGE_kmod-ata-ahci=y

# 【Atlantic网卡驱动】禁用 - Marvell 10G网卡驱动，N1不需要
CONFIG_PACKAGE_kmod-atlantic=n

# 【Broadcom GENET网卡驱动】禁用 - 博通以太网驱动，非N1平台
CONFIG_PACKAGE_kmod-bcmgenet=n

# 【IMX双网卡驱动】禁用 - Freescale i.MX系列网卡，N1不需要
CONFIG_PACKAGE_kmod-dwmac-imx=n

# 【Rockchip网卡驱动】禁用 - 瑞芯微RK系列网卡，N1不需要
CONFIG_PACKAGE_kmod-dwmac-rockchip=n

# 【Allwinner网卡驱动】禁用 - 全志系列网卡，N1不需要
CONFIG_PACKAGE_kmod-dwmac-sun8i=n

# 【Intel e1000e网卡驱动】禁用 - Intel千兆网卡驱动，N1不需要
CONFIG_PACKAGE_kmod-e1000e=n

# 【Freescale DPAA1网络驱动】禁用 - 专用网络驱动，N1不需要
CONFIG_PACKAGE_kmod-fsl-dpaa1-net=n

# 【Freescale DPAA2网络驱动】禁用 - 专用网络驱动，N1不需要
CONFIG_PACKAGE_kmod-fsl-dpaa2-net=n

# 【Freescale ENETC网卡驱动】禁用 - 专用驱动，N1不需要
CONFIG_PACKAGE_kmod-fsl-enetc-net=n

# 【Freescale FEC网卡驱动】禁用 - 旧版Freescale网卡驱动，N1不需要
CONFIG_PACKAGE_kmod-fsl-fec=n

# 【GPIO PCA953x扩展芯片驱动】禁用 - I2C GPIO扩展，N1不需要
CONFIG_PACKAGE_kmod-gpio-pca953x=n

# 【I2C PCA954x多路复用驱动】禁用 - I2C总线复用芯片驱动，N1不需要
CONFIG_PACKAGE_kmod-i2c-mux-pca954x=n

# 【Marvell MVNETA网卡驱动】禁用 - .marvell网卡驱动，N1不需要
CONFIG_PACKAGE_kmod-mvneta=n

# 【Marvell MVPP2网卡驱动】禁用 - Mellanox交换机驱动，N1不需要
CONFIG_PACKAGE_kmod-mvpp2=n

# 【Octeon TX2网卡驱动】禁用 - Cavium OCTEON网卡驱动，N1不需要
CONFIG_PACKAGE_kmod-octeontx2-net=n

# 【Aquantia PHY驱动】禁用 - 10G PHY芯片驱动，N1百兆网卡不需要
CONFIG_PACKAGE_kmod-phy-aquantia=n

# 【Broadcom PHY驱动】禁用 - 博通PHY芯片驱动，N1不需要
CONFIG_PACKAGE_kmod-phy-broadcom=n

# 【Marvell PHY驱动】禁用 - Marvell PHY芯片驱动，N1不需要
CONFIG_PACKAGE_kmod-phy-marvell=n

# 【Marvell 10G PHY驱动】禁用 - 10G PHY驱动，N1不需要
CONFIG_PACKAGE_kmod-phy-marvell-10g=n

# 【RX8025 RTC驱动】禁用 - EPSON RTC时钟芯片驱动，N1不需要
CONFIG_PACKAGE_kmod-rtc-rx8025=n

# 【SFP光纤模块驱动】禁用 - Small Form-Factor光纤模块，N1不需要
CONFIG_PACKAGE_kmod-sfp=n

# 【Cavium ThunderX网卡驱动】禁用 - ARM服务器网卡驱动，N1不需要
CONFIG_PACKAGE_kmod-thunderx-net=n

# 【USB 2.0主机驱动】启用 - N1的USB接口需要此驱动
# 业务逻辑：S905D芯片通过USB 2.0接口连接外部设备
# 使用场景：U盘、移动硬盘、USB WiFi适配器等
CONFIG_PACKAGE_kmod-usb2=y

# 【VMware VMXNET3网卡驱动】禁用 - 虚拟机网卡驱动，N1物理机不需要
CONFIG_PACKAGE_kmod-vmxnet3=n

# 【SP805看门狗驱动】禁用 - 嵌入式看门狗定时器，N1不需要
CONFIG_PACKAGE_kmod-wdt-sp805=n

# ==================================================================================
# 【第五部分】LuCI应用插件配置 - Web界面功能扩展
# 【插件选择策略】选择N1常用功能，平衡功能丰富度和资源占用
# ==================================================================================

# 【文件传输插件】禁用 - 支持通过Web界面上传/下载文件
# 业务逻辑：N1主要作为路由器，文件传输功能需求较少
# 替代方案：可使用Samba或FTP实现文件共享
CONFIG_PACKAGE_luci-app-filetransfer=n

# 【Argon主题配置插件】启用 - Argon主题的Web图形化配置界面
# 业务逻辑：允许用户通过Web界面修改主题配色、背景等设置
# 依赖：必须配合luci-theme-argon主题使用
CONFIG_PACKAGE_luci-app-argon-config=y

# 【磁盘管理插件】启用 - Web界面的磁盘分区、挂载、SMART监控
# 业务逻辑：N1常用于家庭存储，磁盘管理功能必备
# 功能：支持查看磁盘分区、挂载点、RAID配置、SMART信息
CONFIG_PACKAGE_luci-app-diskman=y

# 【OpenClash插件】启用 - Clash代理客户端的Web管理界面
# 业务逻辑：翻墙代理是核心需求，OpenClash是目前最稳定的Clash实现
# 依赖：需配合Clash内核使用，支持Clash.Meta核心
CONFIG_PACKAGE_luci-app-openclash=y

# 【Docker管理插件】启用 - Web界面的Docker容器管理
# 业务逻辑：Docker是N1的重要应用场景，可运行各种容器化服务
# 功能：镜像管理、容器管理、网络配置、存储卷管理
CONFIG_PACKAGE_luci-app-dockerman=y

# 【带宽监视插件】启用 - 实时网络流量监控和统计
# 业务逻辑：监控网络带宽使用情况，便于排查网络问题
# 功能：按接口显示流量、TOP应用统计、历史趋势图
CONFIG_PACKAGE_luci-app-nlbwmon=y

# 【微信推送插件】启用 - 固件状态通知到微信
# 业务逻辑：实现设备在线状态、流量告警、固件更新等微信通知
# 依赖：需要企业微信或其他微信推送服务账号配置
CONFIG_PACKAGE_luci-app-wechatpush=y

# ==================================================================================
# 【第六部分】主题配置 - Web界面视觉主题
# ==================================================================================

# 【Argon主题】启用 - 现代简约的OpenWrt Web主题
# 业务逻辑：相比默认的Bootstrap主题，Argon更美观、更现代
# 特性：支持暗色模式、响应式设计、流畅动画
# 依赖：luci-app-argon-config提供配置界面
CONFIG_PACKAGE_luci-theme-argon=y

# ==================================================================================
# 【第七部分】其他扩展包 - 补充功能软件包
# ==================================================================================

# 【自动核心调整插件】启用 - 根据CPU负载自动调整调度策略
# 业务逻辑：优化N1的CPU调度，提升多任务处理性能
# 功能：自动识别CPU核心数、调整调度器参数
CONFIG_PACKAGE_autocore=y

# 【TRIM定时任务】启用 - SSD/存储设备的TRIM指令支持
# 业务逻辑：定期发送TRIM指令保持存储设备性能
# 适用：配合btrfs的discard选项使用，防止固态硬盘性能衰减
CONFIG_PACKAGE_fstrim=y

# 【PPP协议】禁用 - Point-to-Point Protocol，拨号线上网协议
# 业务逻辑：N1作为二级路由器不需要PPPOE拨号
# 启用后可支持ADSL调制解调器拨号上网
CONFIG_PACKAGE_ppp=n

# 【亚洲时区数据】启用 - 包含中国、日本、韩国等亚洲时区定义
# 业务逻辑：确保系统时间显示正确，配合TZ=Asia/Shanghai使用
# 依赖：需要正确设置系统时区才能显示准确时间
CONFIG_PACKAGE_zoneinfo-asia=y

# ==================================================================================
# 【第八部分】必要工具包 - 系统运维和文件管理必备工具
# 【工具选择原则】N1作为软路由所需的基础命令工具集
# ==================================================================================

# 【Btrfs ZSTD压缩支持】启用 - Btrfs文件系统ZSTD压缩算法支持
# 业务逻辑：ZSTD压缩比高于gzip，CPU开销相近，节省存储空间
# 固件压缩效果：启用后可节省约20-30%根文件系统体积
CONFIG_BTRFS_PROGS_ZSTD=y

# 【文件系统属性工具】启用 - chattr/lsattr命令，管理文件属性
# 业务逻辑：用于设置不可修改属性，防止误删系统文件
# 典型应用：保护/etc配置文件不被意外修改
CONFIG_PACKAGE_attr=y

# 【Bash Shell】启用 - 增强型命令行解释器
# 业务逻辑：相比ash提供更丰富的脚本功能，如数组、字符串处理
# 使用场景：DIY脚本中需要高级Shell语法时需要
CONFIG_PACKAGE_bash=y

# 【_bsdtar归档工具】启用 - 支持多种格式的归档解压缩
# 业务逻辑：处理tar、zip、7z等格式的归档文件
# 使用场景：固件备份恢复、插件安装等
CONFIG_PACKAGE_bsdtar=y

# 【Btrfs工具集】启用 - btrfs-progs，文件系统管理工具
# 业务逻辑：btrfs相关命令工具，如mkfs.btrfs、btrfs-check等
# 依赖：根文件系统使用btrfs，必须包含此工具
CONFIG_PACKAGE_btrfs-progs=y

# 【Chattr工具】启用 - 改变文件属性命令
# 业务逻辑：配合attr包使用，设置不可变属性等
CONFIG_PACKAGE_chattr=y

# 【F2FS工具集】启用 - Flash-Friendly File System工具
# 业务逻辑：虽然N1使用btrfs，但F2FS工具可能被其他场景使用
CONFIG_PACKAGE_f2fs-tools=y

# 【Fdisk分区工具】启用 - 磁盘分区管理命令
# 业务逻辑：磁盘分区创建、删除、修改等操作
# 使用场景：手动分区、挂载存储设备等
CONFIG_PACKAGE_fdisk=y

# 【GAWK工具】启用 - AWK文本处理工具增强版
# 业务逻辑：强大的文本处理和模式匹配工具
# 使用场景：日志分析、数据提取、报告生成等
CONFIG_PACKAGE_gawk=y

# 【Getopt工具】启用 - 命令行参数解析工具
# 业务逻辑：解析脚本的命令行选项和参数
# 使用场景：DIY脚本中需要处理命令行参数时需要
CONFIG_PACKAGE_getopt=y

# 【Lsattr工具】启用 - 显示文件属性命令
# 业务逻辑：查看文件的特殊属性（如不可修改）
# 配合chattr使用
CONFIG_PACKAGE_lsattr=y

# 【Perl解释器】启用 - Perl脚本语言运行环境
# 业务逻辑：许多OpenWrt工具依赖Perl，如ddns-scripts等
# 依赖：luci-app-amlogic等插件可能需要Perl运行时
CONFIG_PACKAGE_perl=y

# 【Perl Getopt模块】启用 - Perl命令行参数处理模块
# 业务逻辑：Perl脚本使用Getopt解析参数
CONFIG_PACKAGE_perlbase-getopt=y

# 【Perl Unicode模块】启用 - Unicode字符编码支持
# 业务逻辑：处理中文等Unicode字符
CONFIG_PACKAGE_perlbase-unicode=y

# 【Perl HTTP日期模块】启用 - HTTP协议日期处理
# 业务逻辑：处理HTTP协议中的日期格式
CONFIG_PACKAGE_perl-http-date=y

# 【Pigz压缩工具】启用 - 并行版gzip压缩工具
# 业务逻辑：利用多核CPU加速压缩/解压缩
# 性能：相比单线程gzip，可提升2-4倍压缩速度
CONFIG_PACKAGE_pigz=y

# 【Tar归档工具】启用 - tar命令，Linux标准归档工具
# 业务逻辑：打包/解包tar/tar.gz/tar.xz等格式
# 使用场景：固件备份、插件安装等
CONFIG_PACKAGE_tar=y

# 【XFS文件系统检查工具】启用 - XFS文件系统检查修复工具
# 业务逻辑：XFS文件系统一致性检查和修复
# 说明：虽然N1主要使用btrfs，但工具集包含以备不时之需
CONFIG_PACKAGE_xfs-fsck=y

# 【XFS文件系统创建工具】启用 - XFS文件系统格式化工具
# 业务逻辑：创建XFS格式的文件系统
# 说明：同上，作为工具集的一部分
CONFIG_PACKAGE_xfs-mkfs=y

# ==================================================================================
# 【第九部分】WiFi相关组件移除 - N1作为有线路由器不需要WiFi
# 【移除原因】
#   1. N1硬件不支持内置WiFi，需要外接USB WiFi适配器
#   2. 作为主路由场景，有线连接更稳定
#   3. 移除后可减少固件体积约5-10MB
#   4. 降低无线干扰和功耗
# ==================================================================================

# 【Hostapd通用组件】禁用 - WiFi接入点认证和加密
# 业务逻辑：WiFi作为AP的核心组件，禁用后不支持WiFi功能
CONFIG_PACKAGE_hostapd-common=n

# 【iw工具】禁用 - Linux无线配置工具
# 业务逻辑：配置无线网卡参数、扫描热点等
CONFIG_PACKAGE_iw=n

# 【Broadcom WiFi驱动】禁用 - brcmfmac驱动，博通芯片WiFi
# 业务逻辑：博通USB WiFi适配器驱动，N1不需要
CONFIG_PACKAGE_kmod-brcmfmac=n

# 【Broadcom WiFi工具库】禁用 - brcmutil驱动，WiFi固件加载
CONFIG_PACKAGE_kmod-brcmutil=n

# 【CFG80211无线配置API】禁用 - Linux无线配置框架
# 业务逻辑：无线网卡驱动的标准接口，禁用后无法使用任何WiFi
CONFIG_PACKAGE_kmod-cfg80211=n

# 【Mac80211无线驱动框架】禁用 - 主流无线网卡驱动框架
# 业务逻辑：支持Intel、Realtek等大量无线网卡
# 禁用原因：N1作为有线路由器不需要WiFi支持
CONFIG_PACKAGE_kmod-mac80211=n

# 【WPA CLI工具】禁用 - WPA Supplicant命令行工具
# 业务逻辑：WiFi连接的配置和管理工具
CONFIG_PACKAGE_wpa-cli=n

# 【WPA简易版无线驱动】禁用 - wpa-supplicant简化版
# 业务逻辑：提供基本的WiFi连接功能
CONFIG_PACKAGE_wpad-basic=n

# ==================================================================================
# 【配置文件结束】
# 本配置总计包含：
#   - 平台配置：4项
#   - IPv6支持：1项
#   - 内核模块：26项
#   - LuCI应用：6项
#   - 主题配置：1项
#   - 扩展包：3项
#   - 工具包：18项
#   - WiFi移除：8项
# 总计约：67项配置项
# ==================================================================================
