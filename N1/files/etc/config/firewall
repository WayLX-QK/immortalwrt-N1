# ==================================================================================
# 防火墙配置文件 (Firewall Configuration)
# 目标设备：斐讯N1
# 技术选型：nftables (OpenWrt 21.02+默认使用nftables替代iptables)
# 说明：用户询问nftables vs iptables，以下是专业分析：
#   nftables优势：性能更高(10-30%提升)、内存占用更低、语法更简洁
#   nftables劣势：某些老旧工具兼容性、过渡期生态略弱
#   结论：nftables是未来主流，OpenWrt 21.02+默认采用，稳定性已有保障
# ==================================================================================

# ==================================================================================
# 【默认策略配置】防火墙全局默认规则
# ==================================================================================
config defaults
	# 【SYN洪水保护】synflood_protect - 防御SYN Flood攻击
	# 业务逻辑：限制TCP连接建立速率，防止DDoS攻击
	# 启用后可保护路由器免受恶意流量攻击
	option synflood_protect '1'
	
	# 【丢弃无效数据包】drop_invalid - 丢弃不符合规范的IP包
	# 业务逻辑：过滤畸形数据包，提升网络效率和安全
	# 配合nftables可高效识别无效包
	option drop_invalid '1'
	
	# 【入站默认策略】input - 到达本机的数据包默认动作
	# ACCEPT：接受所有入站连接（路由器自身服务全面开放）
	# 说明：N1作为旁路由，需要管理界面访问，开放是合理的
	option input 'ACCEPT'
	
	# 【出站默认策略】output - 从本机发出的数据包默认动作
	# ACCEPT：接受所有出站连接（无限制）
	option output 'ACCEPT'
	
	# 【转发默认策略】forward - 通过路由器转发数据包默认动作
	# ACCEPT：允许所有转发（N1作为代理/网关需要）
	# 注意：如作为主路由，建议改为REJECT以提升安全性
	option forward 'ACCEPT'
	
	# 【流量卸载】flow_offloading - 启用硬件/软件流量转发加速
	# 业务逻辑：将数据转发交由硬件或优化路径处理，提升吞吐量
	# 设置为1启用软件flow offloading（N1无硬件加速）
	# 作用：减少CPU转发开销，提升网络性能
	option flow_offloading '1'


# ==================================================================================
# 【LAN区域配置】局域网安全区域定义
# ==================================================================================
config zone
	# 【区域名称】标识LAN区域
	option name 'lan'
	# 【网络接口绑定】将lan接口加入该区域
	list network 'lan'
	# 【入站策略】input ACCEPT - 接受来自LAN的所有流量
	# 业务逻辑：局域网内部互相信任，无需过滤
	option input 'ACCEPT'
	# 【出站策略】output ACCEPT - 允许LAN发出所有流量
	option output 'ACCEPT'
	# 【转发策略】forward ACCEPT - 允许LAN转发到其他区域
	# 配合下面的masq实现NAT共享上网
	option forward 'ACCEPT'
	# 【地址伪装】masq - 启用SNAT/MASQUERADE
	# 业务逻辑：LAN设备通过N1访问互联网时进行IP伪装
	# 效果：LAN内所有设备共享N1的公网IP上网
	option masq '1'

# ==================================================================================
# 【Docker区域配置】Docker容器网络隔离区域
# ==================================================================================
config zone 'docker'
	# 【入站策略】input ACCEPT - 接受Docker容器所有入站流量
	# 业务逻辑：Docker容器间通信需要完全开放
	option input 'ACCEPT'
	# 【出站策略】output ACCEPT - 允许Docker容器所有出站流量
	option output 'ACCEPT'
	# 【转发策略】forward ACCEPT - 允许Docker容器转发流量
	option forward 'ACCEPT'
	# 【区域名称】docker
	option name 'docker'
	# 【网络接口绑定】将docker接口加入该区域
	list network 'docker'

# ==================================================================================
# 【配置结束】
# 本配置文件关键设计：
#   - 全面启用nftables（OpenWrt 21.02+标准）
#   - 默认策略相对宽松（ACCEPT为主），便于旁路由部署
#   - 启用flow_offloading提升转发性能
#   - 启用SYN保护和invalid包丢弃提升安全性
#   - Docker独立区域隔离，便于管理和安全控制
# 关于nftables vs iptables的补充说明：
#   - OpenWrt 21.02使用nftables作为默认防火墙后端
#   - nftables在性能上优于iptables约10-30%
#   - 内存占用更低，适合N1这种资源受限设备
#   - 语法更现代，规则管理更便捷
#   - 兼容性：当前主流应用（OpenClash等）已完全支持nftables
# ==================================================================================
