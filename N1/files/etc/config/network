# ==================================================================================
# OpenWrt 网络接口配置文件 (Network Configuration)
# 目标设备：斐讯N1 (Amlogic S905D)
# 配置说明：定义LAN/WAN/Docker等网络接口参数
# ==================================================================================

# ==================================================================================
# 【回环接口】Loopback Interface - 系统内部通信用
# 用途：本地进程间通信，不需要物理网络设备
# 配置：127.0.0.1/8 标准回环地址
# ==================================================================================
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

# ==================================================================================
# 【Docker网桥接口】Docker Bridge Interface
# 用途：Docker容器网络桥接，使用docker0虚拟网桥
# 配置说明：
#   - proto 'none': 不自动获取IP，Docker daemon自行管理
#   - auto '0': 不随系统启动，用于手动控制
# 注意事项：需要配合luci-app-dockerman使用
# ==================================================================================
config interface 'docker'
	option device 'docker0'
	option proto 'none'
	option auto '0'

# ==================================================================================
# 【LAN接口】Local Area Network - 局域网接口
# 用途：N1的主要网络接口，连接内部网络设备
# 网络规划：192.168.2.0/24 网段（避免与主路由192.168.1.x冲突）
# 配置说明：
#   - proto 'static': 静态IP配置（不通过DHCP获取）
#   - device 'eth0': 绑定到物理网卡eth0（S905D的千兆以太网）
#   - ipaddr '192.168.2.2': N1的管理地址（可从主路由访问）
#   - gateway '192.168.2.1': 主路由器的网关地址
#   - delegate '0': 关闭IPv6委托（避免与主路由IPv6冲突）
#   - broadcast: 广播地址
#   - dns: 主路由作为DNS转发器
# ==================================================================================
config interface 'lan'
	option proto 'static'
	option netmask '255.255.255.0'
	option device 'eth0'
	option ipaddr '192.168.2.2'
	option gateway '192.168.2.1'
	option delegate '0'
	option broadcast '192.168.2.255'
	list dns '192.168.2.1'

# ==================================================================================
# 【LAN桥接设备】LAN Bridge Device
# 用途：将多个物理/虚拟端口桥接成一个逻辑交换机
# 配置：创建br-lan桥接，将eth0加入桥接
# 说明：在复杂网络拓扑下可能需要VLAN桥接
# ==================================================================================
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

# ==================================================================================
# 【Docker网桥设备】Docker Bridge Device
# 用途：Docker的默认网桥，容器网络隔离
# 说明：由Docker daemon自动创建和管理
# ==================================================================================
config device
	option type 'bridge'
	option name 'docker0'

# ==================================================================================
# 【全局网络参数】Global Network Settings
# packet_steering: 包 Steering 多核分发优化
#   - 启用后，内核会将网络包分散到多个CPU核心处理
#   - 提升多核系统的网络处理性能
#   - 适用于高负载路由器场景
# ==================================================================================
config globals 'globals'
	option packet_steering '1'

# ==================================================================================
# 【Tunnel接口】utun接口（用于VPN/代理软件）
# 用途：Tunnel代理软件的虚拟网络接口（如OpenClash的utun）
# 配置：
#   - proto 'none': 不自动配置
#   - auto '0': 手动启用
# 说明：OpenClash等代理软件会创建此接口
# ==================================================================================
config interface 'utun'
	option proto 'none'
	option ifname 'utun'
	option device 'utun'
	option auto '0'

# ==================================================================================
# 【配置文件结束】
# 本配置定义了：
#   - loopback: 本地回环（必需）
#   - lan: 192.168.2.2/24 静态IP（主接口）
#   - docker: Docker网桥接口
#   - utun: 代理软件tunnel接口
#   - packet_steering: 多核包分发（性能优化）
# ==================================================================================
